{
  "info": {
    "name": "BlogNest API",
    "_postman_id": "a0f6b9e4-9e47-4f90-a5f0-blognest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:5000"},
    {"key": "token", "value": ""},
    {"key": "blogId", "value": ""}
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"name\":\"Priya\",\"email\":\"priya@example.com\",\"password\":\"password123\",\"role\":\"author\"}"},
        "url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"]}
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"email\":\"priya@example.com\",\"password\":\"password123\"}"},
        "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"]}
      }
    },
    {
      "name": "Create Blog",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"name\":\"My First Blog\",\"message\":\"Hello from BlogNest\",\"tags\":[\"AI\",\"Blog\"],\"status\":\"published\"}"},
        "url": {"raw": "{{baseUrl}}/api/blogs", "host": ["{{baseUrl}}"], "path": ["api","blogs"]}
      }
    },
    {
      "name": "Fetch Blogs",
      "request": {
        "method": "GET",
        "url": {"raw": "{{baseUrl}}/api/blogs", "host": ["{{baseUrl}}"], "path": ["api","blogs"]}
      }
    },
    {
      "name": "Generate AI Blog",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"topic\":\"The future of artificial intelligence\",\"tone\":\"friendly\",\"audience\":\"college students\"}"},
        "url": {"raw": "{{baseUrl}}/api/ai/generate-blog", "host": ["{{baseUrl}}"], "path": ["api","ai","generate-blog"]}
      }
    },
    {
      "name": "Summarize Blog",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"text\":\"Artificial Intelligence is a field of computer science that creates systems capable of tasks that normally require human intelligence. It is used in healthcare, education, finance and content creation.\"}"},
        "url": {"raw": "{{baseUrl}}/api/ai/summarize", "host": ["{{baseUrl}}"], "path": ["api","ai","summarize"]}
      }
    }
  ]
}